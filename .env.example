# Copy to .env inside data-agent/. Never commit real credentials.
# Storage backend: set DATABASE_URL for PostgreSQL, or leave unset to use the SQLite DATABASE_PATH.
# PostgreSQL example: postgresql+psycopg://user:password@localhost:5432/data_agent
# DATA_AGENT_DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:5432/data_agent
DATA_AGENT_DATABASE_PATH=data/agent.db
DATA_AGENT_HOST=127.0.0.1
DATA_AGENT_PORT=8100
DATA_AGENT_PUBLIC_ORIGIN=http://localhost:8100
# Must be true behind production HTTPS.
DATA_AGENT_COOKIE_SECURE=false
DATA_AGENT_SESSION_SECONDS=43200

# OpenAI-compatible provider; both key and model are required for agent execution.
DATA_AGENT_LLM_BASE_URL=https://api.openai.com/v1
DATA_AGENT_LLM_API_KEY=
DATA_AGENT_LLM_MODEL=
DATA_AGENT_LLM_TIMEOUT=60
DATA_AGENT_LLM_MAX_TOKENS=4096
DATA_AGENT_CONTEXT_TOKENS=24000
DATA_AGENT_MAX_TOOL_ROUNDS=8

DATA_AGENT_LEASE_SECONDS=120
DATA_AGENT_POLL_SECONDS=1
DATA_AGENT_LOG_LEVEL=INFO
DATA_AGENT_WEB_DIST=web/dist

# Optional Feishu HTTP event subscription. Configure all four to enable it.
DATA_AGENT_FEISHU_APP_ID=
DATA_AGENT_FEISHU_APP_SECRET=
DATA_AGENT_FEISHU_VERIFICATION_TOKEN=
DATA_AGENT_FEISHU_ENCRYPT_KEY=
